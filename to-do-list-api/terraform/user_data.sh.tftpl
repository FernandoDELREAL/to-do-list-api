#!/bin/bash
# Se ejecuta una sola vez al arrancar la EC2. Log en /var/log/cloud-init-output.log
set -euxo pipefail

dnf install -y git python3.11 python3.11-pip unzip

# 1) Clonar el repo (en la version indicada: ultimo tag o main)
git clone --depth 1 --branch "${git_ref}" "${repo_url}" /opt/todo

# 2) Instalar dependencias en un virtualenv
python3.11 -m venv /opt/venv
/opt/venv/bin/pip install --upgrade pip
/opt/venv/bin/pip install -r /opt/todo/src/requirements.txt

# 3) Variables de ambiente de la app (el deploy actualiza APP_VERSION)
cat > /etc/todo.env <<EOF
APP_VERSION=${app_version}
DB_SECRET_NAME=${secret_name}
AWS_REGION=${region}
AWS_DEFAULT_REGION=${region}
METRICS_NAMESPACE=TodoListApp
EOF

# 4) Servicio systemd para que la app arranque sola y se reinicie si se cae
cat > /etc/systemd/system/todo.service <<'EOF'
[Unit]
Description=to-do-list-api
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/todo.env
WorkingDirectory=/opt/todo/src
ExecStart=/opt/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now todo
